# Application settings
APP_NAME=falcon_ai_services
APP_ENV=development
LOG_LEVEL=INFO

# AI Provider Configuration (e.g. dual, qwen, placeholder, online)
MODEL_PROVIDER=dual

# Qwen Model Configuration
MODEL_PATH=/path/to/models/Qwen2.5-7B-Instruct-Q4_K_M.gguf
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
MODEL_TOP_P=0.9
MODEL_CONTEXT_LENGTH=4096
MODEL_GPU_LAYERS=28
MODEL_REPEAT_PENALTY=1.1

# Intelligence Layer Configuration
DEFAULT_RESPONSE_PROFILE=normal
ENABLE_DYNAMIC_RESPONSE=true
ENABLE_CONTEXT_MANAGER=true
ENABLE_HALLUCINATION_GUARD=true
ENABLE_SESSION_MANAGER=true
ENABLE_PROMPT_VALIDATOR=true
MAX_CONVERSATION_HISTORY=10
SESSION_TIMEOUT=3600

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=*
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=60
ENABLE_STREAMING=true
