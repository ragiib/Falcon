# Application settings
APP_NAME=falcon_ai_services
APP_ENV=development
LOG_LEVEL=INFO

# Add other AI API keys and configuration here later
MODEL_PROVIDER=placeholder

# Qwen Model Configuration
MODEL_PATH=/path/to/models/Qwen2.5-14B-Q4_K_M.gguf
MODEL_TEMPERATURE=0.7
MODEL_MAX_TOKENS=2048
MODEL_TOP_P=0.9
MODEL_CONTEXT_LENGTH=4096
MODEL_GPU_LAYERS=32
MODEL_REPEAT_PENALTY=1.1

# API Configuration
API_HOST=0.0.0.0
API_PORT=8000
API_DEBUG=true
ENABLE_CORS=true
CORS_ALLOWED_ORIGINS=*
MAX_REQUEST_SIZE=10485760
REQUEST_TIMEOUT=60
ENABLE_STREAMING=true
